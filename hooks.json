{
  "paper-deterministic-guardrails": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "invoke_subagent",
        "hooks": [
          {
            "type": "command",
            "command": "python scripts/run_hook.py",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "python scripts/run_hook.py",
        "timeout": 90
      }
    ]
  }
}
