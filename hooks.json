{
  "paper-deterministic-guardrails": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "invoke_subagent",
        "hooks": [
          {
            "type": "command",
            "command": "python -m agy_paper_agent.hooks_entry",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "python -m agy_paper_agent.hooks_entry",
        "timeout": 90
      }
    ]
  }
}
